{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=zvtgjvsqehhvutyrbsil&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    }
  },
  "plugin": ["context-mode"],
  "references": {
    "db-schema": {
      "path": "../07-DB-Schema",
      "description": "Schema de base de datos, tablas, columnas y referencias a crear, esto no esta implementado en la base de datos, es solo un esquema de referencia para el desarrollo del proyecto."
    }
  }
}
