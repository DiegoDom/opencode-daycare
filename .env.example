SUPABASE_DB_PASSWORD=your_database_password

# Cliente Supabase (@supabase/ssr). La publishable key viaja al navegador:
# nunca pongas aqui la secret key / service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Email de invitación (server-only). RESEND_API_KEY es requerida para enviar;
# RESEND_FROM y APP_URL tienen defaults en código (ver lib/email/resend.ts).
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=OpenDayCare <onboarding@resend.dev>
APP_URL=http://localhost:3000